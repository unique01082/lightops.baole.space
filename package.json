{
  "name": "lightops",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tauri build",
    "build:api": "pnpm --filter @lightops/api build",
    "build:frontend": "vite build",
    "dev": "tauri dev",
    "dev:frontend": "vite",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "openapi:client": "pnpm --filter @lightops/api openapi:snapshot && api2ts",
    "pretty": "prettier --write .",
    "pretty:check": "prettier --check .",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:api": "pnpm --filter @lightops/api test",
    "test:release": "node --test scripts/*.test.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
