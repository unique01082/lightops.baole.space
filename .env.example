# Public native-client settings. Never add a VITE_OIDC_CLIENT_SECRET.
VITE_OIDC_AUTHORITY=https://id.baole.space/application/o/lightops/
VITE_OIDC_CLIENT_ID=lightops
# Must exactly match the URI registered on the LightOps provider.
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=https://lightops.baole.space/auth
VITE_LIGHTOPS_API_URL=https://lightops.baole.space
