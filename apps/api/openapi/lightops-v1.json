        ]
      }
    },
    "/api/v1/sync/exchange": {
      "post": {
        "operationId": "SyncController_exchange",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SyncExchangeDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncExchangeResponseDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
